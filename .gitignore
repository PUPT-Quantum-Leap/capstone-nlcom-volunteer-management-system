# Node modules
node_modules/
vendor/

# Lock files - IMPORTANT: Lock files should be committed for reproducible builds
# Only ignore lock files in vendor/node_modules subdirectories
**/node_modules/**/package-lock.json
**/vendor/**/composer.lock

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.*.local
.server.env

# Gitleaks report
gitleaks-report.json

# Local gitleaks false-positive overrides (per-developer, never committed)
.gitleaksignore

# Private server configuration
VPS_CONFIG_PRIVATE.md
session-transcript-*.md
deployment-*.md
vps-hardening-guide.md
PRODUCTION_DOCKER_PLAN.md
project-deployment-*.md

# SSH/AWS private keys - NEVER commit these!
*.pem
*.key
*.ppk
