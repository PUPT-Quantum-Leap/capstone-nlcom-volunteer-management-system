APP_NAME=ServeTrack
APP_ENV=production
APP_DEBUG=false
APP_URL=https://servetrack.kaelvxdev.space

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=servetrack
DB_USERNAME=servetrack
DB_PASSWORD=change_me_on_vps

BROADCAST_DRIVER=log
