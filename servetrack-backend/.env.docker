SANCTUM_STATEFUL_DOMAINS=servetrack.kaelvxdev.space
SESSION_DOMAIN=servetrack.kaelvxdev.space
SANCTUM_ENCRYPT_COOKIES=true

MAIL_MAILER=log
MAIL_FROM_NAME=ServeTrack
