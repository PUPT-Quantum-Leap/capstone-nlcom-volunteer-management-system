# Stage 1: Builder
FROM php:8.2-fpm-alpine AS builder

RUN apk add --no-cache \
    git curl zip unzip \
    libpng-dev libxml2-dev libzip-dev libicu-dev \
    mysql-client \
    && docker-php-ext-install pdo_mysql bcmath gd xml zip intl opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

COPY composer.json composer.lock ./
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-scripts

COPY . .
RUN composer dump-autoload --optimize

# Stage 2: Production
FROM php:8.2-fpm-alpine

RUN apk add --no-cache \
    libpng libxml2 libzip icu-libs mysql-client \
    && docker-php-ext-install pdo_mysql bcmath gd xml zip intl opcache

COPY --from=builder /var/www /var/www

WORKDIR /var/www

RUN mkdir -p storage/framework/{cache,sessions,views} storage/logs \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY docker-entrypoint.prod.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.prod.sh

EXPOSE 9000

ENTRYPOINT ["docker-entrypoint.prod.sh"]
CMD ["php-fpm"]