{
  "name": "servetrack-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "start:docker": "ng serve --host 0.0.0.0 --poll 2000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.3",
  "dependencies": {
    "@angular/common": "^21.2.4",
    "@angular/compiler": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/forms": "^21.2.4",
    "@angular/platform-browser": "^21.2.4",
    "@angular/router": "^21.2.4",
    "@ng-icons/core": "^33.2.2",
    "@ng-icons/heroicons": "^33.2.2",
    "dompurify": "^3.4.5",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "marked": "^12.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "^0.16.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.1",
    "@analogjs/vitest-angular": "^2.6.1",
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.4",
    "@angular/language-service": "^21.2.4",
    "@angular/platform-browser-dynamic": "^21.2.4",
    "@types/leaflet": "^1.9.21",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "21.3.0",
    "eslint": "^9.39.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.61.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "undici": "^7.24.2",
    "ajv": "^8.18.0",
    "hono": "^4.12.8",
    "flatted": "^3.4.1"
  }
}
