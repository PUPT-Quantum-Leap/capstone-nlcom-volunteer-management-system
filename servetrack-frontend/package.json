{
  "name": "servetrack-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "start:docker": "ng serve --host 0.0.0.0 --poll 2000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.3",
  "dependencies": {
    "@angular/common": "^21.2.4",
    "@angular/compiler": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/forms": "^21.2.4",
    "@angular/platform-browser": "^21.2.4",
    "@angular/router": "^21.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.4.9",
    "@analogjs/vitest-angular": "^2.4.9",
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.9",
    "@angular/language-service": "^21.2.9",
    "@angular/platform-browser-dynamic": "^21.2.9",
    "@vitest/coverage-v8": "^4.1.4",
    "angular-eslint": "21.3.1",
    "eslint": "^9.39.2",
    "jsdom": "^29.0.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.58.2",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "undici": "^7.24.2",
    "ajv": "^8.18.0",
    "hono": "^4.12.8",
    "flatted": "^3.4.1"
  }
}
