[Unit]
Description=ServeTrack Laravel Backend
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/servetrack/current/backend

EnvironmentFile=/var/www/servetrack/shared/.env

ExecStart=/usr/bin/php artisan serve --host=127.0.0.1 --port=8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
