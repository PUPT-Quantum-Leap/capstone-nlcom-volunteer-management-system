# ServeTrack Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Application
APP_NAME=ServeTrack
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Database
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
DB_DATABASE=servetrack
DB_USERNAME=servetrack
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Admin Security
ADMIN_INVITE_CODE=CHANGE_ME_STRONG_INVITE_CODE
ADMIN_ALLOWED_DOMAINS=yourdomain.com

# Sanctum
SANCTUM_STATEFUL_DOMAINS=yourdomain.com

# Mail (Optional - configure when ready)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"
